# Token da Apify — usado SOMENTE pelos scripts em /scripts (nunca exposto ao frontend).
# Obtenha em https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# URL pública do site (usada em metadados, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://lequarttie.vercel.app

# Deixe "false" enquanto o site for uma demonstração privada.
# Mude para "true" somente após aprovação da loja e autorização das imagens.
NEXT_PUBLIC_ALLOW_INDEXING=false
